OPENROUTER_API_KEY=your-openrouter-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# The n8n instance the pipeline builds and verifies against. This must be a DEV/personal instance -
# verification deploys workflows and executes them, which must never happen on a client's live host.
N8N_API_URL=https://your-personal-n8n-instance
N8N_API_KEY=your-n8n-api-key-here
